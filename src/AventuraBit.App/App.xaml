<Application x:Class="AventuraBit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="FuenteCodigo">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="FuenteIconos">Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="Texto" Color="#1E293B" />
        <SolidColorBrush x:Key="TextoSuave" Color="#64748B" />
        <SolidColorBrush x:Key="Verde" Color="#22C55E" />
        <SolidColorBrush x:Key="VerdeOscuro" Color="#15803D" />
        <SolidColorBrush x:Key="Azul" Color="#3B82F6" />
        <SolidColorBrush x:Key="AzulOscuro" Color="#1D4ED8" />
        <SolidColorBrush x:Key="Naranja" Color="#F59E0B" />
        <SolidColorBrush x:Key="NaranjaOscuro" Color="#B45309" />
        <SolidColorBrush x:Key="Rojo" Color="#EF4444" />
        <SolidColorBrush x:Key="RojoOscuro" Color="#B91C1C" />
        <SolidColorBrush x:Key="Morado" Color="#8B5CF6" />
        <SolidColorBrush x:Key="MoradoOscuro" Color="#6D28D9" />
        <SolidColorBrush x:Key="Gris" Color="#E2E8F0" />
        <SolidColorBrush x:Key="GrisOscuro" Color="#94A3B8" />

        <DropShadowEffect x:Key="Sombra" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#0F172A" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>

        <!-- Tarjeta blanca redondeada -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource Sombra}" />
        </Style>

        <!-- Botón de juego: redondeado, con "suelo" más oscuro que le da relieve -->
        <Style x:Key="BotonJuego" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Verde}" />
            <Setter Property="BorderBrush" Value="{StaticResource VerdeOscuro}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Suelo" CornerRadius="16" Background="{TemplateBinding BorderBrush}" Margin="0,4,0,0" />
                            <Border x:Name="Cara" CornerRadius="16" Background="{TemplateBinding Background}" Margin="0,0,0,4">
                                <Border x:Name="Brillo" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cara" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cara" Property="Margin" Value="0,3,0,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAzul" TargetType="Button" BasedOn="{StaticResource BotonJuego}">
            <Setter Property="Background" Value="{StaticResource Azul}" />
            <Setter Property="BorderBrush" Value="{StaticResource AzulOscuro}" />
        </Style>
        <Style x:Key="BotonNaranja" TargetType="Button" BasedOn="{StaticResource BotonJuego}">
            <Setter Property="Background" Value="{StaticResource Naranja}" />
            <Setter Property="BorderBrush" Value="{StaticResource NaranjaOscuro}" />
        </Style>
        <Style x:Key="BotonRojo" TargetType="Button" BasedOn="{StaticResource BotonJuego}">
            <Setter Property="Background" Value="{StaticResource Rojo}" />
            <Setter Property="BorderBrush" Value="{StaticResource RojoOscuro}" />
        </Style>
        <Style x:Key="BotonMorado" TargetType="Button" BasedOn="{StaticResource BotonJuego}">
            <Setter Property="Background" Value="{StaticResource Morado}" />
            <Setter Property="BorderBrush" Value="{StaticResource MoradoOscuro}" />
        </Style>
        <Style x:Key="BotonBlanco" TargetType="Button" BasedOn="{StaticResource BotonJuego}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>

        <!-- Botón pequeño plano para las flechas de ordenar -->
        <Style x:Key="BotonFlecha" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="10" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Black" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
