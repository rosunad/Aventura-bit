<UserControl x:Class="AventuraBit.App.Controles.DibujoBit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="110" x:Name="Cuerpo" RenderTransformOrigin="0.5,1">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Escala" />
                    <RotateTransform x:Name="Giro" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Sombra -->
            <Ellipse Canvas.Left="22" Canvas.Top="100" Width="56" Height="10" Fill="#330F172A" />

            <!-- Antena -->
            <Line X1="50" Y1="20" X2="50" Y2="7" Stroke="#0369A1" StrokeThickness="3" StrokeStartLineCap="Round" />
            <Ellipse x:Name="LuzAntena" Canvas.Left="43" Canvas.Top="0" Width="14" Height="14" Fill="#FACC15" Stroke="#CA8A04" StrokeThickness="2" />

            <!-- Brazos -->
            <Rectangle Canvas.Left="15" Canvas.Top="74" Width="12" Height="22" RadiusX="6" RadiusY="6" Fill="#0284C7" />
            <Rectangle Canvas.Left="73" Canvas.Top="74" Width="12" Height="22" RadiusX="6" RadiusY="6" Fill="#0284C7" />

            <!-- Cuerpo -->
            <Rectangle Canvas.Left="25" Canvas.Top="68" Width="50" Height="30" RadiusX="11" RadiusY="11" Stroke="#0369A1" StrokeThickness="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38BDF8" Offset="0" />
                        <GradientStop Color="#0EA5E9" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Canvas.Left="43" Canvas.Top="76" Width="14" Height="14" Fill="#FDE047" Stroke="#CA8A04" StrokeThickness="2" />

            <!-- Ruedas -->
            <Ellipse Canvas.Left="28" Canvas.Top="94" Width="18" Height="12" Fill="#334155" />
            <Ellipse Canvas.Left="54" Canvas.Top="94" Width="18" Height="12" Fill="#334155" />

            <!-- Cabeza -->
            <Rectangle Canvas.Left="12" Canvas.Top="16" Width="76" Height="56" RadiusX="20" RadiusY="20" Stroke="#0369A1" StrokeThickness="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7DD3FC" Offset="0" />
                        <GradientStop Color="#0EA5E9" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Pantalla de la cara -->
            <Rectangle Canvas.Left="20" Canvas.Top="24" Width="60" Height="40" RadiusX="13" RadiusY="13" Fill="#0F172A" />

            <Canvas x:Name="Ojos">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="Mirada" />
                </Canvas.RenderTransform>
                <Ellipse x:Name="OjoIzq" Canvas.Left="31" Canvas.Top="32" Width="12" Height="16" Fill="#67E8F9" />
                <Ellipse x:Name="OjoDer" Canvas.Left="57" Canvas.Top="32" Width="12" Height="16" Fill="#67E8F9" />
                <Ellipse Canvas.Left="34" Canvas.Top="34" Width="4" Height="5" Fill="White" />
                <Ellipse Canvas.Left="60" Canvas.Top="34" Width="4" Height="5" Fill="White" />
            </Canvas>
            <Path x:Name="Boca" Stroke="#67E8F9" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 41,53 Q 50,60 59,53" />

            <!-- Mofletes -->
            <Ellipse Canvas.Left="22" Canvas.Top="50" Width="8" Height="5" Fill="#F472B6" Opacity="0.8" />
            <Ellipse Canvas.Left="70" Canvas.Top="50" Width="8" Height="5" Fill="#F472B6" Opacity="0.8" />
        </Canvas>
    </Viewbox>
</UserControl>
